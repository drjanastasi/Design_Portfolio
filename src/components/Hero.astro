---
import Button from './Button.astro';
import Nav from './Nav.astro';
import WorkItem from './WorkItem.astro';

const work = [
  { number: '01', title: 'Old Lion Publishing', meta: 'Web · E-commerce' },
  { number: '02', title: 'Fitness tracker', meta: 'iOS + Apple Watch' },
  { number: '03', title: 'Lviv Croissants', meta: 'Website redesign' },
];
---

<div class="hero">
  <div class="canvas">
    <div class="glow glow-top" aria-hidden="true">
      <img src="/assets/glow-top.svg" width="1120" height="1120" alt="" />
    </div>
    <div class="glow glow-bottom" aria-hidden="true">
      <img src="/assets/glow-bottom.svg" width="918" height="918" alt="" />
    </div>

    <Nav />

    <main class="content">
      <div class="headline">
        <p class="badge">Open to full-time roles · Remote or hybrid in Poland</p>
        <h1>
          <span>PRODUCT </span>
          <span>DESIGNER<i>.</i></span>
        </h1>
      </div>

      <!-- Placeholder: the design has a plain grey block here. -->
      <div class="media" aria-hidden="true"></div>

      <div class="intro">
        <p>
          Focused on <strong>e-commerce and mobile</strong>. I design the path from the first click
          to the purchase — and the everyday flows people come back to.
        </p>
        <div class="ctas">
          <Button href="#work" variant="primary">View case studies</Button>
          <Button href="#">Download CV</Button>
        </div>
      </div>

      <section class="work" id="work" aria-labelledby="work-title">
        <h2 id="work-title">SELECTED WORK</h2>
        <ol>
          {work.map((item) => <WorkItem {...item} />)}
        </ol>
      </section>
    </main>
  </div>
</div>

<style>
  .hero {
    position: relative;
    min-height: max(100vh, calc(980 * var(--u)));
    overflow: hidden;
  }

  /* Glows are placed against the centred 1440px frame but only clipped by .hero. */
  .canvas {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    padding: calc(70 * var(--u)) calc(80 * var(--u)) calc(111 * var(--u));
  }

  .canvas > :global(header),
  .content {
    position: relative;
  }

  .glow {
    position: absolute;
    pointer-events: none;
  }

  .glow img {
    display: block;
    width: calc(var(--size) * var(--u));
    height: calc(var(--size) * var(--u));
  }

  .glow-top {
    --size: 1120;
    top: calc(-470 * var(--u));
    left: calc(50% + 62 * var(--u));
  }

  .glow-bottom {
    --size: 918;
    top: calc(439 * var(--u));
    left: calc(50% - 1060 * var(--u));
  }

  .content {
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(572 * var(--u));
    row-gap: calc(40 * var(--u));
    margin-top: calc(72 * var(--u));
  }

  .headline {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(32 * var(--u));
  }

  .badge {
    padding: calc(9 * var(--u)) calc(18 * var(--u)) calc(9 * var(--u)) calc(16 * var(--u));
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-size: max(12px, calc(16 * var(--u)));
    font-weight: 500;
    line-height: 1.366;
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: calc(32 * var(--u));
    font-family: var(--font-display);
    font-size: calc(96 * var(--u));
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  h1 i {
    color: var(--color-accent);
    font-style: normal;
  }

  .media {
    height: calc(378 * var(--u));
    background: #d9d9d9;
  }

  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: calc(32 * var(--u));
  }

  .intro p {
    max-width: calc(600 * var(--u));
    color: var(--color-text-muted);
    font-size: calc(24 * var(--u));
    line-height: 1.5;
  }

  .intro strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: calc(16 * var(--u));
  }

  .work {
    display: flex;
    flex-direction: column;
    gap: calc(8 * var(--u));
    justify-self: end;
    width: calc(565 * var(--u));
  }

  h2 {
    color: var(--color-text-muted);
    font-size: max(12px, calc(16 * var(--u)));
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.366;
  }

  @media (max-width: 899px) {
    .canvas {
      padding: 32px 24px 64px;
    }

    .content {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
      margin-top: 48px;
    }

    h1 {
      /* "DESIGNER." is the longest line; keep it inside the screen. */
      font-size: min(72px, calc((100vw - 48px) / 6.8));
      gap: 0.25em;
    }

    .media {
      height: auto;
      aspect-ratio: 572 / 378;
    }

    .work {
      justify-self: stretch;
      width: auto;
    }
  }
</style>
